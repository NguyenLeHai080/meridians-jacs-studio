# Used to prefill the Admin Portal login email at build time.
JACS_ADMIN_EMAIL=admin@example.com
# Keep the PBKDF2 value in single quotes because it contains `$` separators.
JACS_ADMIN_PASSWORD_HASH='replace-with-pbkdf2-hash'
JACS_CORS_ORIGINS=https://jacs-studio.nexoratech.com.vn
JACS_TELEMETRY_INGEST_TOKEN=replace-with-random-token
JACS_TOKEN_TTL_MINUTES=60
JACS_PROVIDER_TIMEOUT_SECONDS=30
JACS_DB_NAME=jacs_prod
JACS_DB_USER=jacs_prod
JACS_DB_PASSWORD=replace-with-random-db-password
JACS_DATABASE_URL=postgresql://jacs_prod:replace-with-random-db-password@postgres:5432/jacs_prod
JACS_SECRET_KEY=replace-with-fernet-key
