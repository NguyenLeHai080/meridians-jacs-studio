{
  "name": "jacs-studio",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:admin": "pnpm --dir FE/admin-portal dev",
    "build:admin": "pnpm --dir FE/admin-portal build",
    "dev:desktop": "pnpm --dir FE/desktop-app dev",
    "dev:electron": "pnpm --dir FE/desktop-app dev:electron",
    "build:desktop": "pnpm --dir FE/desktop-app build",
    "build:release": "node scripts/build-and-release.cjs",
    "test:desktop": "pnpm --dir FE/desktop-app test:native",
    "verify:api": "make test-api && make compile-api && make export-openapi"
  }

}
