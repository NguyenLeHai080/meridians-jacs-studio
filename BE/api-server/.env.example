JACS_ENV=development
JACS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
JACS_ADMIN_EMAIL=admin@example.com
JACS_ADMIN_PASSWORD=change-me
# Production: set a generated PBKDF2-SHA256 hash and remove/ignore JACS_ADMIN_PASSWORD.
JACS_ADMIN_PASSWORD_HASH=
JACS_TOKEN_TTL_MINUTES=60
JACS_STORE_BACKEND=memory
JACS_SQLITE_PATH=./data/jacs.sqlite3
JACS_TELEMETRY_ENABLED=true
# Set this in staging/production; leave empty only for local development.
JACS_TELEMETRY_INGEST_TOKEN=
JACS_PROVIDER_TIMEOUT_SECONDS=30
